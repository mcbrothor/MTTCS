# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# App login (server-only, never prefix with NEXT_PUBLIC_)
# Set false only when you intentionally want to disable login protection.
MTN_AUTH_ENABLED=true
MTN_ADMIN_USERNAME=<your-login-id>
MTN_ADMIN_PASSWORD=<your-strong-password>
MTN_AUTH_SECRET=<random-32-byte-or-longer-secret>

# Cron/API maintenance
# Used by Vercel Cron and local scripts that call /api/cron/*.
CRON_SECRET=<random-cron-secret>
MTN_BASE_URL=https://mttcs.vercel.app
# Keep false in production. true forces the weekly performance report to preview without Telegram delivery.
RECOMMENDATION_WEEKLY_DRY_RUN=false
RECOMMENDATION_WEEKLY_MIN_D5_SAMPLE=5
RECOMMENDATION_WEEKLY_MAX_DATA_LAG_DAYS=3

# KIS API (Korea Investment & Securities)
KIS_APP_KEY=<your-kis-app-key>
KIS_APP_SECRET=<your-kis-app-secret>
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
# 미설정 기본: 실전 120ms, 모의투자(openapivts) 1050ms
# KIS_REQUEST_INTERVAL_MS=120
# 토큰 발급과 일반 조회는 서로 다른 제한 키를 사용합니다.
# KIS_TOKEN_REQUEST_INTERVAL_MS=1050
# Supabase RPC 기반 공유 제한기는 Supabase 관리자 설정이 있으면 기본 활성화됩니다.
# KIS_DISTRIBUTED_RATE_LIMIT_ENABLED=true
# KIS_DISTRIBUTED_RATE_LIMIT_RETRY_MS=60000
# AI Agent가 같은 제한기를 사용할 때만 32바이트 이상의 임의값을 설정하세요.
KIS_RATE_LIMIT_COORDINATOR_SECRET=

# Telegram Bot (User Setup Required)
TELEGRAM_BOT_TOKEN=<your-bot-token>
TELEGRAM_ALLOWED_CHAT_IDS=<your-chat-id>
TELEGRAM_WEBHOOK_SECRET=<random-secret-string>

# Gemini AI (Market analysis)
# 발급처: https://aistudio.google.com/
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Groq fallback
# 발급처: https://console.groq.com/keys
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=openai/gpt-oss-120b

# Cerebras fallback
CEREBRAS_API_KEY=<your-cerebras-api-key>
CEREBRAS_MODEL=qwen-3-235b-a22b-instruct-2507

# SEC EDGAR (Optional)
SEC_USER_AGENT=MTN/4.0 your-email@example.com

# Local Analysis Worker (Mac mini / local server)
# Prefer storing the real URL in ~/.config/mtn/local-postgres-url for launchd.
LOCAL_POSTGRES_URL=postgresql://mtn_worker:<password>@127.0.0.1:5432/mtn_local
MTN_LOCAL_WORKER_ID=macmini-main
MTN_LOCAL_WORKER_POLL_MS=15000
MTN_LOCAL_WORKER_STALE_AFTER_SECONDS=900
MTN_LOCAL_WORKER_JOB_TYPES=FINANCIAL_AUDIT,THESIS_CHECK,COMMITTEE_REVIEW,NEWS_PULSE,RECOMMENDATION_BACKTEST
