{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["markets", "report_markdown"],
  "additionalProperties": false,
  "properties": {
    "markets": {
      "type": "object",
      "required": ["US", "KR"],
      "additionalProperties": false,
      "properties": {
        "US": { "$ref": "#/$defs/top10" },
        "KR": { "$ref": "#/$defs/top10" }
      }
    },
    "report_markdown": { "type": "string" }
  },
  "$defs": {
    "top10": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["rank", "ticker", "source", "reason", "confidence", "risk"],
        "additionalProperties": false,
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 10 },
          "ticker": { "type": "string", "minLength": 1 },
          "source": {
            "type": "string",
            "enum": ["minervini", "canslim", "leader", "momentum", "qullamaggie", "mixed"]
          },
          "reason": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "risk": { "type": "string" }
        }
      }
    }
  }
}
