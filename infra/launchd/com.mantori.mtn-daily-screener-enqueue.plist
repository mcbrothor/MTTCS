<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mantori.mtn-daily-screener-enqueue</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/node@24/bin/node</string>
    <string>--env-file=/Users/mantori/vibecoding/MTN/.env.local</string>
    <string>/Users/mantori/vibecoding/MTN/scripts/enqueue-daily-screener.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/mantori/vibecoding/MTN</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>16</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/tmp/mtn-daily-screener-enqueue.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/mtn-daily-screener-enqueue.err.log</string>
</dict>
</plist>
