<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mantori.mtn-local-postgres-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/mantori/vibecoding/MTN/scripts/backup-local-postgres.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/mantori/vibecoding/MTN</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>10</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/mtn-local-postgres-backup.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/mtn-local-postgres-backup.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/opt/postgresql@16/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>MTN_LOCAL_POSTGRES_URL_FILE</key>
    <string>/Users/mantori/.config/mtn/local-postgres-url</string>
    <key>MTN_LOCAL_POSTGRES_BACKUP_DIR</key>
    <string>/Users/mantori/.local/share/mtn/backups</string>
  </dict>
</dict>
</plist>
