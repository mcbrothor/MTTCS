{
  "name": "mantori-trading-navigator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "check:api-auth": "node scripts/check-api-auth.mjs",
    "quality": "npm run lint && npm run typecheck && npm run test:unit && npm run check:api-auth",
    "codex:worker": "node --env-file=.env.local scripts/local-llm-worker.mjs",
    "daily:screener:enqueue": "node --env-file=.env.local scripts/enqueue-daily-screener.mjs",
    "daily:screener:watchdog": "node --env-file=.env.local scripts/daily-screener-watchdog.mjs",
    "local:worker": "scripts/run-local-analysis-worker.sh",
    "local:worker:once": "scripts/run-local-analysis-worker.sh --once",
    "local:analysis:enqueue": "node --env-file=.env.local scripts/enqueue-local-analysis-jobs.mjs",
    "local:postgres:health": "scripts/local-postgres-health.sh",
    "local:postgres:backup": "scripts/backup-local-postgres.sh",
    "rs:metrics": "node scripts/run-rs-metrics.mjs",
    "rs:metrics:dry": "node scripts/run-rs-metrics.mjs --dry-run",
    "backtest:gold": "node --env-file=.env.local scripts/run-gold-backtest.mjs",
    "smoke:gold-providers": "node --env-file=.env.local scripts/smoke-gold-providers.mjs",
    "backtest:nasdaq": "node --env-file=.env.local scripts/run-nasdaq-backtest.mjs",
    "smoke:nasdaq-providers": "node --env-file=.env.local scripts/smoke-nasdaq-providers.mjs",
    "smoke:nasdaq-cron": "node --env-file=.env.local scripts/smoke-nasdaq-cron.mjs",
    "test:smoke": "npx playwright test --config=playwright.smoke.config.ts",
    "test:smoke:cp": "npx playwright test --config=playwright.smoke.config.ts --grep='CP-'",
    "test:smoke:ft": "npx playwright test --config=playwright.smoke.config.ts --grep='FT-'",
    "test:smoke:ed": "npx playwright test --config=playwright.smoke.config.ts --grep='ED-'"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "2.110.2",
    "adm-zip": "^0.5.17",
    "axios": "1.18.1",
    "fast-xml-parser": "5.9.3",
    "framer-motion": "^12.38.0",
    "grammy": "^1.42.0",
    "idb-keyval": "^6.2.2",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jiti": "^2.6.1",
    "msw": "^2.14.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "^16.2.3",
    "lightningcss-win32-x64-msvc": "^1.32.0"
  }
}
